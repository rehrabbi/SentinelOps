# Template for local secrets. Copy to .env and fill in real values:
#   cp .env.example .env
# The real .env is git-ignored and must NEVER be committed.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=sentinelops

# Terraform state backend, needed only to run infra/terraform.sh. Start from the
# DIRECT (connection pooling off) connection string of the sentinelops-tfstate
# Neon project; never the -pooler one, which breaks Terraform's state locking.
# Then adjust it for Terraform's Postgres driver:
#   - remove &channel_binding=require (the driver does not support it)
#   - change sslmode=require to sslmode=verify-full (checks Neon's certificate)
#   - append &options=endpoint%3D<endpoint-id>, where the endpoint ID is the
#     first part of the hostname (ep-...), because the driver does not send SNI
PG_CONN_STR=
