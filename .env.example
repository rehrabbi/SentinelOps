# Template for local secrets. Copy to .env and fill in real values:
#   cp .env.example .env
# The real .env is git-ignored and must NEVER be committed.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=sentinelops

# Terraform state backend, needed only to run terraform in infra/: the DIRECT
# (connection pooling off) connection string of the sentinelops-tfstate Neon
# project. Never the -pooler one, which breaks Terraform's state locking.
PG_CONN_STR=
